# Сборочные артефакты Cargo
/target/

# Файлы зависимостей при сборке
**/*.rs.bk

# Артефакты тестов/бенчмарков
Cargo.lock
# Если это библиотека, Cargo.lock обычно не коммитят
# Для бинарного проекта наоборот — лучше оставить Cargo.lock

# IDE и редакторы
.vscode/
.idea/
*.iml

# Rust analyzer
*.swp
*.swo

# MacOS / Linux / Windows мусор
.DS_Store
Thumbs.db
